rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function canAccessBoard(userId) {
      return isOwner(userId) || isAdmin();
    }

    function isValidNode(document) {
      return document.keys().hasOnly(["id", "data", "position"])
        && document.id is string
        && document.id.size() > 0
        && document.data is map
        && document.data.keys().hasOnly(["label", "completed"])
        && document.data.label is string
        && document.data.label.size() > 0
        && document.data.label.size() <= 120
        && document.data.completed is bool
        && document.position is map
        && document.position.keys().hasOnly(["x", "y"])
        && document.position.x is number
        && document.position.y is number;
    }

    function dependencyDocId(sourceId, targetId) {
      return sourceId + "__" + targetId;
    }

    function dependencyEdgeId(sourceId, targetId) {
      return "e" + sourceId + "-" + targetId;
    }

    function isValidEdge(document, edgeDocId) {
      return document.keys().hasOnly(["id", "source", "target", "animated"])
        && document.id is string
        && document.source is string
        && document.target is string
        && document.source.size() > 0
        && document.target.size() > 0
        && document.animated is bool
        && edgeDocId == dependencyDocId(document.source, document.target)
        && document.id == dependencyEdgeId(document.source, document.target);
    }

    function isValidUserProfile(document, userId) {
      return document.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "taskCount",
          "completedCount",
          "pendingCount",
          "blockedCount",
          "readyCount",
          "unlinkedCount",
          "circularCount",
          "dependencyCount",
          "updatedAt"
        ])
        && document.uid is string
        && document.uid == userId
        && document.email is string
        && document.email.size() <= 320
        && document.displayName is string
        && document.displayName.size() <= 120
        && document.taskCount is number
        && document.taskCount >= 0
        && document.completedCount is number
        && document.completedCount >= 0
        && document.pendingCount is number
        && document.pendingCount >= 0
        && document.blockedCount is number
        && document.blockedCount >= 0
        && document.readyCount is number
        && document.readyCount >= 0
        && document.unlinkedCount is number
        && document.unlinkedCount >= 0
        && document.circularCount is number
        && document.circularCount >= 0
        && document.dependencyCount is number
        && document.dependencyCount >= 0
        && document.updatedAt is string
        && document.updatedAt.size() <= 40;
    }

    function isValidBoardProfile(document) {
      return document.keys().hasOnly([
          "name",
          "taskCount",
          "completedCount",
          "pendingCount",
          "blockedCount",
          "readyCount",
          "unlinkedCount",
          "circularCount",
          "dependencyCount",
          "updatedAt"
        ])
        && document.name is string
        && document.name.size() > 0
        && document.name.size() <= 120
        && document.taskCount is number
        && document.taskCount >= 0
        && document.completedCount is number
        && document.completedCount >= 0
        && document.pendingCount is number
        && document.pendingCount >= 0
        && document.blockedCount is number
        && document.blockedCount >= 0
        && document.readyCount is number
        && document.readyCount >= 0
        && document.unlinkedCount is number
        && document.unlinkedCount >= 0
        && document.circularCount is number
        && document.circularCount >= 0
        && document.dependencyCount is number
        && document.dependencyCount >= 0
        && document.updatedAt is string
        && document.updatedAt.size() <= 40;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if canAccessBoard(userId);
      allow create, update: if canAccessBoard(userId)
        && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;

      match /boards/{boardId} {
        allow read: if canAccessBoard(userId);
        allow create, update: if canAccessBoard(userId)
          && isValidBoardProfile(request.resource.data);
        allow delete: if canAccessBoard(userId);

        match /nodes/{nodeDocId} {
          allow read: if canAccessBoard(userId);
          allow create, update: if canAccessBoard(userId) && isValidNode(request.resource.data);
          allow delete: if canAccessBoard(userId);
        }

        match /edges/{edgeDocId} {
          allow read: if canAccessBoard(userId);
          allow create: if canAccessBoard(userId) && isValidEdge(request.resource.data, edgeDocId);
          allow update: if false;
          allow delete: if canAccessBoard(userId);
        }
      }

      match /nodes/{nodeDocId} {
        allow read: if canAccessBoard(userId);
        allow create, update: if canAccessBoard(userId) && isValidNode(request.resource.data);
        allow delete: if canAccessBoard(userId);
      }

      match /edges/{edgeDocId} {
        allow read: if canAccessBoard(userId);
        allow create: if canAccessBoard(userId) && isValidEdge(request.resource.data, edgeDocId);
        allow update: if false;
        allow delete: if canAccessBoard(userId);
      }
    }
  }
}
